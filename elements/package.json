{
  "name": "agent-elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI elements the agent and people share: each with a state, named actions, a history and revert. A lab to try them alone.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "lab": "node build.mjs && node --env-file-if-exists=.env scripts/lab.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "preact": "^10.26.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
