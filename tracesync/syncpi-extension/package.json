{
  "name": "syncpi-extension",
  "version": "0.2.0",
  "description": "/sync: make a pi session a syncpi session, shared with collaborators, while pi keeps running its own turns",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix ../syncpi run build && tsx test/sync.ts"
  },
  "dependencies": {
    "syncpi": "file:../syncpi"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "ws": "^8.22.0"
  }
}
