{
  "name": "syncpi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@earendil-works/pi-env": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@pierre/diffs": "^1.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "marked": "^15.0.12",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.101.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "description": "A multiplayer pi session whose agent runs on its own exe.dev VM",
  "bin": {
    "syncpi": "dist/cli.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node build.mjs && tsx test/smoke.ts",
    "desktop": "npm run build && cargo build --manifest-path desktop/Cargo.toml --bin syncpi-desktop && node scripts/desktop-dev.mjs",
    "icon": "node scripts/build-icon.mjs",
    "test:desktop": "node build.mjs && tsx test/desktop.ts",
    "package:mac": "npm run build && cargo build --manifest-path desktop/Cargo.toml --release --bin syncpi-desktop && node scripts/package-macos.mjs",
    "test:native": "node scripts/test-native.mjs",
    "desktop:host": "npm run build && node dist/desktop-host.mjs"
  }
}
